---
import { getCollection } from 'astro:content';
import Layout from "../../layouts/default.astro"
import PostList from '../../components/post-list.astro';
import ContentAside from '../../components/content-aside.astro';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout title="Posts">
  <ContentAside title="Recent posts" />
  <PostList class:list="content-posts" posts={posts} />
</Layout>
