---
import ContentAside from './content-aside.astro';
import Date from './date.astro';

const { title, date, tags, background } = Astro.props;

const styleProp = background ? { style: `--background-image: url(${background.image.src})` } : {};
---
<ContentAside title={title}>
  <div class="content-background" {...styleProp}></div>
  <p class="content-date"><Date date={date} class="highlight"></p>
  <span class="content-tags highlight">Tags: 
  {tags.map((tag: string, index: number) => {
    const showComma = index < tags.length - 1;

    return (<span><a href={`/tags/${tag.replace(/\s/g, "-")}`}>{tag}{showComma ? ',' : ''}</a>&nbsp;</span>);
  })}
  </span>
  {background?.credit ? (
    <p><span class="highlight text-small">Background image credit: <a href={background.credit.url}>{background.credit.text}</a></span></p>
  ) : null}
</ContentAside>
<article class="content-body">
  <slot />
</article>
